# Copy to .env and change the password. Never commit .env.
POSTGRES_USER=bayarea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bayarea

# Used by the backend and Alembic when running outside Docker.
# For a managed database (Neon, Supabase, RDS, Render…), paste its URL here,
# keeping the postgresql+psycopg:// prefix and adding ?sslmode=require.
DATABASE_URL=postgresql+psycopg://bayarea:change-me@localhost:5432/bayarea

# Optional connection-pool tuning
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_S=1800
# DB_ECHO=false
